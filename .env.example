# --- Server ---
# Port the HTTP + WebSocket server listens on
PORT=3001

# Public base URL used for QR codes / join links (no trailing slash).
# In production set this to the URL players actually reach, e.g. the
# Cloudflare Tunnel hostname: https://escape.example.com
PUBLIC_BASE_URL=http://localhost:5173

# Absolute or relative path to the SQLite database file.
DATABASE_FILE=./data/kfw-escape.sqlite

# Set to "production" when running the built image.
NODE_ENV=development

# Set to 1 when served over HTTPS so identity cookies get the Secure flag.
COOKIE_SECURE=0

# Password for the game master login. Set this and the game can be started and
# steered from any device - which is what you need when the laptop that created
# the session is not the machine you are sitting at. Leave it EMPTY and there is
# no login: the host secret then stays in the browser that created the session.
#
# With a password set, creating a session also requires the login, so nobody who
# merely knows the URL can open sessions on your server.
# Players are never affected - they still join with a display name only.
HOST_PASSWORD=

# Failed logins per source IP per five minutes before the login locks out.
# Successful logins never count against it.
HOST_LOGIN_RATE_LIMIT=10

# Sessions a single source IP may create per minute.
SESSION_RATE_LIMIT=10

# Comma separated list of allowed origins for CORS/WebSocket.
# Leave empty to allow same-origin only (the default in production).
CORS_ORIGINS=http://localhost:5173

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Max join attempts per source IP per minute. A whole team usually shares one
# office IP, so this has to fit a full room arriving at once.
JOIN_RATE_LIMIT=120

# --- Web (Vite, build time) ---
# Where the browser should reach the server. Leave empty to use the
# same origin the app was served from (correct for Docker/production).
VITE_SERVER_URL=http://localhost:3001
